  <diagram id="p0" name="Indeks">
    <mxGraphModel dx="1215" dy="767" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin-bottom:6px;&quot;&gt;Skenario Use Case SIA: Layanan Hasil Studi (Pertemuan 5)&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-bottom:8px;&quot;&gt;Melanjutkan diagram SIA Pertemuan 4 (tidak diubah). Setiap tabel skenario ada pada tab masing-masing.&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr style=&quot;background:#e6e6e6;font-weight:bold;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;Catatan pemetaan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC07&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Lihat Kalender Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Civitas Akademika&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Ditulis satu kali atas nama Civitas Akademika; berlaku untuk Mahasiswa dan Dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC08&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Input Nilai Mata Kuliah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Dosen&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Prasyarat dosen pengampu; alternatif nilai di luar rentang ditolak; direalisasikan SIA-CO01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC09&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Lihat KHS&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Hanya nilai yang sudah dipublikasikan yang ditampilkan; direalisasikan SIA-CO02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC10&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Kelola Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Skenario umum pengelolaan; langkah bersama dirujuk UC11, UC12, UC13&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC11&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Tambah Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Khusus dari UC10; pembeda: data mahasiswa baru tersimpan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC12&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Ubah Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Khusus dari UC10; pembeda: data mahasiswa berubah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC13&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Hapus Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Khusus dari UC10; pembeda: data mahasiswa terhapus; syarat tidak ada data akademik aktif&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-weight:bold;font-size:13px;margin:14px 0 6px;&quot;&gt;Pemeriksaan checklist C.4 dan penelusuran relasi&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr style=&quot;background:#e6e6e6;font-weight:bold;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;Kode&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;Relasi yang ditelusur&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;&quot;&gt;Checklist C.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC07&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Association Civitas Akademika ke UC07; Generalization Mahasiswa dan Dosen ke Civitas Akademika (skenario satu kali)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC08&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Association Dosen ke UC08; Realization SIA-CO01 ke UC08 (hanya di keterangan)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC09&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Association Mahasiswa ke UC09; Realization SIA-CO02 ke UC09 (hanya di keterangan)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC10&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Association Admin Akademik ke UC10; UC10 sebagai use case umum (generalization dari UC11, UC12, UC13)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC11&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Generalization UC11 ke UC10 (hanya perilaku pembeda, rujuk ke tabel UC10)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC12&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Generalization UC12 ke UC10 (hanya perilaku pembeda, rujuk ke tabel UC10)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;SIA-UC13&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Generalization UC13 ke UC10 (hanya perilaku pembeda, rujuk ke tabel UC10)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px;vertical-align:top;&quot;&gt;Terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="760" width="780" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p1" name="SIA-UC07">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:13px;margin-bottom:6px;&quot;&gt;Tabel S.1 Skenario Use Case SIA-UC07 Lihat Kalender Akademik&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;SIA-UC07 Lihat Kalender Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Civitas Akademika (berlaku untuk Mahasiswa dan Dosen)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Civitas Akademika dapat mengetahui agenda resmi kalender akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Civitas Akademika membuka fungsi kalender akademik, memilih periode akademik, dan melihat agenda resmi institusi pada periode tersebut. Skenario ditulis satu kali dan berlaku sama untuk Mahasiswa dan Dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;1. Civitas Akademika membuka fungsi Lihat Kalender Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;2. Sistem menampilkan daftar periode akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;3. Civitas Akademika memilih periode akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;4. Sistem menampilkan kalender akademik periode tersebut berisi agenda resmi, yaitu awal semester, batas KRS, dan masa ujian&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;5. Kalender akademik periode yang dipilih belum tersedia (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;6. Sistem menampilkan pesan kalender akademik periode tersebut belum tersedia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Use case selesai jika kalender akademik periode yang dipilih ditampilkan; jika kalender belum tersedia, use case selesai dengan pesan tersebut.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;&quot;&gt;Catatan aktor: Mahasiswa dan Dosen adalah aktor khusus dari Civitas Akademika dan mewarisi use case ini. Tidak ada perbedaan perilaku antara Mahasiswa dan Dosen, sehingga tidak ada tabel terpisah untuk keduanya. Use case ini tidak mempunyai include, extend, maupun collaboration.&lt;/div&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="780" height="661" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="SIA-UC08">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:13px;margin-bottom:6px;&quot;&gt;Tabel S.2 Skenario Use Case SIA-UC08 Input Nilai Mata Kuliah&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;SIA-UC08 Input Nilai Mata Kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Nilai mata kuliah mahasiswa tersimpan oleh dosen pengampu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Dosen memilih mata kuliah yang diampunya, mengisi nilai mahasiswa, dan menyimpan nilai tersebut. Prasyarat: dosen adalah pengampu mata kuliah terpilih dan masa perkuliahan mata kuliah telah berakhir&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;1. Dosen membuka fungsi Input Nilai Mata Kuliah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;2. Sistem menampilkan daftar mata kuliah yang masa perkuliahannya telah berakhir&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;3. Dosen memilih mata kuliah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;4. Sistem memeriksa bahwa dosen adalah pengampu mata kuliah tersebut dan menampilkan daftar mahasiswa peserta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;5. Dosen mengisi nilai untuk mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;6. Sistem memeriksa bahwa nilai berada dalam rentang yang sah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;7. Dosen menyimpan nilai&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;8. Sistem menyimpan nilai dengan status belum dipublikasikan dan menampilkan ringkasan nilai yang tersimpan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;9. Dosen bukan pengampu mata kuliah yang dipilih (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;10. Sistem menolak penginputan dan menampilkan pesan bahwa dosen tidak berhak atas mata kuliah tersebut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;11. Nilai yang diisi berada di luar rentang yang sah (cabang dari langkah 6)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;12. Sistem menolak nilai tersebut dan meminta dosen memperbaiki isian nilai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Use case selesai jika nilai tersimpan dengan status belum dipublikasikan; jika dosen bukan pengampu, tidak ada nilai yang tersimpan; jika nilai di luar rentang yang sah, nilai tidak tersimpan sampai isian diperbaiki.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;&quot;&gt;Keterangan tabel: use case ini direalisasikan oleh collaboration SIA-CO01 Input Nilai Mata Kuliah. Collaboration tersebut tidak mempunyai langkah kegiatan pada tabel ini. Nilai hanya dapat diinput oleh dosen pengampu mata kuliah tersebut. Rentang nilai yang sah belum ditetapkan pada tugas.&lt;/div&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="780" height="930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="SIA-UC09">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:13px;margin-bottom:6px;&quot;&gt;Tabel S.3 Skenario Use Case SIA-UC09 Lihat KHS&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;SIA-UC09 Lihat KHS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Mahasiswa mengetahui hasil studi semester yang nilainya sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Mahasiswa membuka fungsi Lihat KHS, memilih semester, dan melihat KHS yang hanya memuat nilai yang sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;1. Mahasiswa membuka fungsi Lihat KHS&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;2. Sistem menampilkan daftar semester&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;3. Mahasiswa memilih semester&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;4. Sistem menampilkan KHS semester tersebut yang hanya memuat nilai yang sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;5. Belum ada nilai yang dipublikasikan pada semester yang dipilih (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;6. Sistem tidak menampilkan KHS dan menampilkan pemberitahuan bahwa belum ada nilai yang dipublikasikan pada semester tersebut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Use case selesai jika KHS semester terpilih ditampilkan dengan nilai yang sudah dipublikasikan; jika belum ada nilai terpublikasi, tidak ada KHS yang ditampilkan dan use case selesai dengan pemberitahuan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;&quot;&gt;Keterangan tabel: use case ini direalisasikan oleh collaboration SIA-CO02 Lihat KHS. Collaboration tersebut tidak mempunyai langkah kegiatan pada tabel ini. Nilai yang belum dipublikasikan tidak pernah ditampilkan pada KHS.&lt;/div&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="780" height="627" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="SIA-UC10">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:13px;margin-bottom:6px;&quot;&gt;Tabel S.4 Skenario Use Case SIA-UC10 Kelola Data Mahasiswa&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;SIA-UC10 Kelola Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Data mahasiswa terkelola melalui satu fungsi pengelolaan bersama&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Admin Akademik membuka fungsi pengelolaan data mahasiswa, memilih bentuk pengelolaan, dan menyimpan perubahan. Bentuk tambah, ubah, dan hapus dijabarkan pada tabel khususnya masing-masing&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;1. Admin Akademik membuka fungsi Kelola Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;2. Sistem menampilkan daftar data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;3. Admin Akademik memilih bentuk pengelolaan, yaitu tambah, ubah, atau hapus&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;4. Sistem menampilkan formulir sesuai bentuk pengelolaan yang dipilih&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;5. Admin Akademik mengisi atau mengonfirmasi data mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;6. Sistem memeriksa kelengkapan dan keabsahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;7. Admin Akademik menyimpan perubahan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;8. Sistem menyimpan perubahan dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;9. Data tidak lengkap atau tidak sah (cabang dari langkah 6)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;10. Sistem menolak penyimpanan dan menampilkan pesan kesalahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Use case selesai jika perubahan data mahasiswa tersimpan; jika data tidak lengkap atau tidak sah, perubahan tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;&quot;&gt;Keterangan tabel: use case umum bagi SIA-UC11 Tambah Data Mahasiswa, SIA-UC12 Ubah Data Mahasiswa, dan SIA-UC13 Hapus Data Mahasiswa. Tabel ini memuat perilaku bersama; ketiga use case khusus hanya memuat perilaku pembeda dan merujuk ke tabel ini.&lt;/div&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="780" height="761" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="SIA-UC11">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:13px;margin-bottom:6px;&quot;&gt;Tabel S.5 Skenario Use Case SIA-UC11 Tambah Data Mahasiswa&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;SIA-UC11 Tambah Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Data mahasiswa baru tersimpan sebagai bentuk khusus dari pengelolaan data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Admin Akademik mengisi data mahasiswa baru, yaitu NIM, nama, dan program studi, lalu menyimpan data tersebut; langkah bersama mengikuti Tabel skenario SIA-UC10&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;1. Admin Akademik membuka fungsi Tambah Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;2. Sistem menampilkan formulir data mahasiswa baru&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;3. Admin Akademik mengisi NIM, nama, dan program studi mahasiswa baru&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;4. Sistem memeriksa kelengkapan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;5. Admin Akademik menyimpan data&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;6. Sistem menyimpan data mahasiswa baru dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;7. Data tidak lengkap (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;8. Sistem menolak penyimpanan dan meminta Admin Akademik melengkapi data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Use case selesai jika data mahasiswa baru tersimpan; jika data tidak lengkap, data tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;&quot;&gt;Keterangan: use case khusus dari SIA-UC10 Kelola Data Mahasiswa. Perilaku pembeda: data mahasiswa baru tersimpan. Langkah bersama mengikuti Tabel skenario SIA-UC10.&lt;/div&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="780" height="643" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="SIA-UC12">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:13px;margin-bottom:6px;&quot;&gt;Tabel S.6 Skenario Use Case SIA-UC12 Ubah Data Mahasiswa&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-size:12px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;SIA-UC12 Ubah Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Data mahasiswa berubah sebagai bentuk khusus dari pengelolaan data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;width:45%;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Admin Akademik memilih data mahasiswa, mengubah datanya, dan menyimpan perubahan; langkah bersama mengikuti Tabel skenario SIA-UC10&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;1. Admin Akademik memilih data mahasiswa yang akan diubah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;2. Sistem menampilkan data mahasiswa saat ini&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;3. Admin Akademik mengubah data mahasiswa&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;4. Sistem memeriksa perubahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;5. Admin Akademik menyimpan perubahan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;6. Sistem menyimpan data yang diubah dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;background:#f5f5f5;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;7. Data mahasiswa tidak ditemukan (cabang dari langkah 2)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;8. Sistem menampilkan pesan data mahasiswa tidak ditemukan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;9. Data hasil perubahan tidak lengkap atau tidak sah (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;10. Sistem menolak penyimpanan dan menampilkan pesan kesalahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;font-weight:bold;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 6px;vertical-align:top;&quot;&gt;Use case selesai jika perubahan data mahasiswa tersimpan; jika data tidak ditemukan atau data hasil perubahan tidak lengkap atau tidak sah, perubahan tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;&quot;&gt;Keterangan: use case khusus dari SIA-UC10 Kelola Data Mahasiswa. Perilaku pembeda: data mahasiswa berubah. Langkah bersama mengikuti Tabel skenario SIA-UC10.&lt;/div&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="780" height="727" as="geometry" />
        </mxCell>
      </root>
